# Google OAuth web client credentials (server-only; never use NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Must exactly match a redirect URI configured in Google Auth Platform
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# Optional: Drive folder ID. Leave blank to save uploads in My Drive root.
GOOGLE_DRIVE_FOLDER_ID=

# Share this invite code only with people allowed to submit models.
POLY_NOOK_SUBMISSION_CODE=
